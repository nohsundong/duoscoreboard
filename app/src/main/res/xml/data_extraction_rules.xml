<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Nothing leaves the device through cloud backup. -->
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <!-- Local device-to-device transfer may carry the match history and settings. -->
    <device-transfer>
        <include
            domain="database"
            path="." />
        <include
            domain="file"
            path="datastore" />
    </device-transfer>
</data-extraction-rules>
